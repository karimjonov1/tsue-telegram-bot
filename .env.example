# =================================================================
# TSUE Telegram Bot Configuration (.env)
# =================================================================

# Telegram Bot API Token obtained from @BotFather
BOT_TOKEN="9287521871:AAGPFqAHPP43-z6MwKqElq2PcuOFnoBrYts"

# Telegram User IDs of administrators (comma-separated, get from @userinfobot)
ADMIN_IDS="6283031909"

# Database connection URL (aiosqlite for async SQLite)
DB_URL="sqlite+aiosqlite:///./data/tsue_bot.db"

# Semester start date (used for Week A/B alternating logic)
# TSUE Fall 2026 starts on 2026-09-07
SEMESTER_START_DATE="2026-09-07"

# Default reminder lead time in minutes before lesson starts
DEFAULT_REMINDER_LEAD_MINUTES="10"

# Directories for SQLite database, cache, and backups
DATA_DIR="./data"
CACHE_DIR="./data/cache"
BACKUP_DIR="./data/backups"

# Backup retention count (keep last N compressed backups)
BACKUP_RETENTION_COUNT="7"

# Port for lightweight Docker healthcheck and preview server
HEALTH_PORT="3000"

# Optional webhook URL (leave empty for long polling)
WEBHOOK_URL=""
